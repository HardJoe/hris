NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hris_app:REPLACE_WITH_A_STRONG_DATABASE_PASSWORD@database:5432/hris
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_ISSUER=hris-api
JWT_AUDIENCE=hris-web
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880
SWAGGER_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
POSTGRES_DB=hris
POSTGRES_USER=hris_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
