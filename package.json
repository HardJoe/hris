{
  "name": "hris-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend-node",
    "frontend"
  ],
  "scripts": {
    "backend:build": "npm run build --workspace backend-node",
    "backend:lint": "npm run lint --workspace backend-node",
    "backend:test": "npm run test --workspace backend-node",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:lint": "npm run lint --workspace frontend",
    "frontend:test": "npm run test --workspace frontend",
    "frontend:typecheck": "npm run typecheck --workspace frontend"
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.0.0"
  }
}
